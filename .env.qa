# ============================================================
# QA Test Configuration (.env file)
# ============================================================
# Copy this file to .env and set actual values for your QA environment

# Database Configuration
DB_HOST=qa-db-server
DB_PORT=3306
DB_NAME=qa_database
DB_USER=qa_user
DB_PASSWORD=your_qa_password_here

# Application Configuration
APP_PORT=8082
APP_ENVIRONMENT=qa
APP_DEBUG=true

# Health Check Configuration
HEALTH_CHECK_URL=http://localhost:8082/actuator/health
HEALTH_CHECK_TIMEOUT=20
HEALTH_CHECK_RETRIES=3

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=logs/qa-application.log

# Test Configuration
TEST_TIMEOUT=30000
TEST_RETRY_COUNT=3
TEST_PARALLEL_EXECUTION=false

# Performance Configuration
MAX_THREADS=10
CONNECTION_POOL_SIZE=10
CACHE_ENABLED=false
